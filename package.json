{
  "name": "trivia-kahoot",
  "version": "1.0.0",
  "description": "Trivia multijugador en tiempo real tipo Kahoot",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "consumer:analitica": "node consumers/analiticaRespuestasConsumer.js",
    "consumer:alertas": "node consumers/alertasRespuestasConsumer.js",
    "consumer:partidas:1": "cross-env CONSUMER_ID=partidas-1 node consumers/partidasEventosConsumer.js",
    "consumer:partidas:2": "cross-env CONSUMER_ID=partidas-2 node consumers/partidasEventosConsumer.js",
    "consumer:sala-abandonada": "node consumers/salaAbandonadaConsumer.js",
    "consumer:dlq-respuestas": "node consumers/dlqRespuestasInvalidasConsumer.js",
    "consumer:dlq-alertas": "node consumers/dlqAlertasRechazadasConsumer.js",
    "start:all": "concurrently -n SERVER,ANALITICA,ALERTAS,PARTIDAS-1,PARTIDAS-2,SALA-TTL,DLQ-RESP,DLQ-ALERT -c blue,green,magenta,yellow,yellowBright,cyan,red,redBright \"npm:dev\" \"npm:consumer:analitica\" \"npm:consumer:alertas\" \"npm:consumer:partidas:1\" \"npm:consumer:partidas:2\" \"npm:consumer:sala-abandonada\" \"npm:consumer:dlq-respuestas\" \"npm:consumer:dlq-alertas\""
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "socket.io": "^4.6.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1"
  }
}